rules_version = '2';

// AlgoBook v2 — every read and write goes through the API (firebase-admin); the browser never
// touches Firestore directly (src/lib/firebase.ts initialises Auth only). Deny everything to clients so
// a leaked web API key + ID token cannot enumerate users/problems or write drafts. Deploy with
// `npm run db:deploy`. (Module 05 audit, 2026-09-08; supersedes the Module 01/04 per-collection rules.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
